    {
      "id": "search_by_barcode_numeric",
      "method": "erpnext.erpnext_integrations.ecommerce_api.api.search_by_barcode",
      "args": {
        "barcode": 7790580132170,
        "price_list": "Standard Selling"
      },
      "expect": "no_500",
      "source": "regression",
      "bug": "AttributeError: int barcode had no .strip() — coerce via cstr in _item_codes_for_barcode",
      "note": "Flutter/JSON may send barcode as number and drop leading zeros"
    },
    {
